-- TOC entry 379 (class 1255 OID 47909)
-- Name: sanity_check_compensation_batch_phase_history(); Type: FUNCTION; Schema: ops; Owner: -
--

CREATE FUNCTION ops.sanity_check_compensation_batch_phase_history() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_compensation_phase_rank INTEGER;
BEGIN
    -- Get compensation phase rank for this batch (NULL if not a compensation batch)
    SELECT CASE pp.type
               WHEN 'cutting'   THEN 1
               WHEN 'sewing'    THEN 2
               WHEN 'qc'        THEN 3
               WHEN 'packaging' THEN 4
               ELSE NULL
           END INTO v_compensation_phase_rank
    FROM ops.batch_compensations bc
    JOIN core.production_phases pp ON pp.phase_id = bc.phase_id
    WHERE bc.batch_id = NEW.batch_id
    LIMIT 1;

    IF v_compensation_phase_rank IS NULL THEN
        RETURN NEW;
    END IF;

    -- Phases at or before compensated: "in" <= 0. Phases strictly before: "out" <= 0.
    IF v_compensation_phase_rank >= 1 THEN
        NEW.inspection_qty := LEAST(COALESCE(NEW.inspection_qty, 0), 0);
    END IF;
    IF v_compensation_phase_rank >= 2 THEN
        NEW.sewing_in_qty := LEAST(COALESCE(NEW.sewing_in_qty, 0), 0);
    END IF;
    IF v_compensation_phase_rank > 2 THEN
        NEW.sewing_out_qty := LEAST(COALESCE(NEW.sewing_out_qty, 0), 0);
    END IF;
    IF v_compensation_phase_rank >= 3 THEN
        NEW.qc_in_qty := LEAST(COALESCE(NEW.qc_in_qty, 0), 0);
    END IF;
    IF v_compensation_phase_rank > 3 THEN
        NEW.qc_out_qty := LEAST(COALESCE(NEW.qc_out_qty, 0), 0);
    END IF;
    IF v_compensation_phase_rank >= 4 THEN
        NEW.packaging_in_qty := LEAST(COALESCE(NEW.packaging_in_qty, 0), 0);
    END IF;
    IF v_compensation_phase_rank > 4 THEN
        NEW.packaging_out_qty := LEAST(COALESCE(NEW.packaging_out_qty, 0), 0);
    END IF;

    RETURN NEW;
END;
$$;


