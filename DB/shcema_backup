CREATE FUNCTION ops.sync_cuts_on_job_order_update() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    UPDATE ops.cut_details
    SET print_status = CASE
        WHEN NEW.print_config IS NULL
             OR jsonb_typeof(NEW.print_config) IS DISTINCT FROM 'object'
             OR NOT EXISTS (
                 SELECT 1 FROM jsonb_each_text(NEW.print_config)
             )
        THEN NULL
        WHEN print_status IS NULL THEN 'pending'
        ELSE print_status
    END
    WHERE job_order_id = OLD.job_order_id;

    PERFORM ops.refresh_job_order_items_summary_for_jobs(ARRAY[NEW.job_order_id]);
    PERFORM reporting.refresh_job_order_summary_for_jobs(ARRAY[NEW.job_order_id]);

    RETURN NEW;
END;
$$;


