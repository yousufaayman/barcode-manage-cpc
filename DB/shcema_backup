CREATE FUNCTION ops.update_cut_total_layers() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_cut_id INTEGER;
BEGIN
    v_cut_id = COALESCE(NEW.cut_id, OLD.cut_id);
    
    -- Update cut_details with new totals
    -- Note: The UPDATE will trigger refresh_summary_on_cut_update if total_layers changed
    UPDATE ops.cut_details
    SET
        total_layers = (
            SELECT COALESCE(SUM(num_of_layers), 0)
            FROM ops.cut_rolls
            WHERE cut_id = v_cut_id
        ),
        num_of_rolls_used = (
            SELECT COUNT(*)
            FROM ops.cut_rolls
            WHERE cut_id = v_cut_id
        )
    WHERE cut_id = v_cut_id;
    
    RETURN COALESCE(NEW, OLD);
END;
$$;


