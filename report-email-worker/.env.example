# Base URL of the FastAPI backend API (must include /api/v1, no trailing slash).
# Same Docker host as main app (nginx on port 80): use host gateway to reach the host-published port.
API_BASE_URL=http://host.docker.internal:80/api/v1

# Dedicated reporting user in the app (must exist; role must allow report PDF endpoints).
REPORT_SERVICE_USERNAME=reporting

# Password for REPORT_SERVICE_USERNAME (required).
REPORT_SERVICE_PASSWORD=changeme

# SMTP (Gmail example; use an app password for Gmail).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
REPORT_SENDER_EMAIL=
REPORT_SENDER_PASSWORD=
REPORT_RECIPIENT_EMAILS=ops@example.com,manager@example.com

COMPANY_NAME=Production Management System

# IANA timezone for the cron schedule and “today” date.
SCHEDULE_TZ=Africa/Cairo

# Cron: minute hour day month day_of_week (5 fields). Default 23:00 daily.
SCHEDULE_CRON=0 23 * * *

# Which calendar day to fetch: yesterday | today
REPORT_DATE_MODE=yesterday
