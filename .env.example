# PostgreSQL host reachable from containers through Docker host gateway mapping.
DB_HOST=host.docker.internal

# PostgreSQL port exposed on the Windows Server host.
DB_PORT=5432

# PostgreSQL database name used by the backend.
DB_NAME=appdb

# PostgreSQL username used by the backend.
DB_USER=appuser

# PostgreSQL password used by the backend.
DB_PASSWORD=changeme

# In-container path where backend writes uploaded media files.
MEDIA_ROOT=/app/media

# In-container path for PDF report output (backend REPORTS_DIR; bind-mounted from host).
REPORTS_ROOT=/app/reports

# Comma-separated browser origins (scheme+host+port). App is exposed on host port 81 in docker-compose.
BACKEND_CORS_ORIGINS=http://192.168.0.249:81,http://192.168.0.106:81

# --- report-email-worker (docker compose service: report-email-worker) ---
# API_BASE_URL is set in docker-compose.yml to http://backend:8000/api/v1 (do not rely on host.docker.internal).
REPORT_SERVICE_USERNAME=reporting
REPORT_SERVICE_PASSWORD=changeme

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
REPORT_SENDER_EMAIL=
REPORT_SENDER_PASSWORD=
REPORT_RECIPIENT_EMAILS=ops@example.com,manager@example.com

COMPANY_NAME=Production Management System
SCHEDULE_TZ=Africa/Cairo
SCHEDULE_CRON=0 23 * * *
REPORT_DATE_MODE=yesterday
